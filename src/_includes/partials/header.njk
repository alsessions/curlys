{# Site Header with Navigation #}
{% from "_components/index.njk" import button %}

<header class="sticky top-0 z-50 bg-zinc-950/95 backdrop-blur-sm border-b border-red-700/60" x-data="{ mobileMenuOpen: false }">
  <div class="container">
    <nav class="flex items-center justify-between h-16 md:h-20">
      {# Brand #}
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-primary-300 no-underline hover:text-primary-200 flex-1">
        <img src="/favicon.svg" alt="" width="32" height="32" class="w-8 h-8" eleventy:ignore>
        <span class="hidden sm:inline">{{ metadata.title | default("Curly's") }}</span>
        <span class="sr-only">{{ metadata.title | default("Curly's") }}</span>
      </a>

      {# Desktop Navigation #}
      <div class="hidden md:flex items-center gap-8">
        {% for item in header.navigation %}
          <a
            href="{{ item.url }}"
            class="nav-link text-sm font-semibold text-zinc-200 hover:text-primary-300 transition-colors no-underline{% if page.url == item.url %} text-primary-300{% endif %}"
          >
            {{ item.label }}
          </a>
        {% endfor %}
      </div>

      {# Right side: CTA + Mobile menu #}
      <div class="flex items-center justify-end gap-3 flex-1">
        {# Desktop CTA #}
        {% if header.cta %}
          <div class="hidden md:block">
            {{ button({
              text: header.cta.label,
              url: header.cta.url,
              variant: "primary",
              size: "sm"
            }) }}
          </div>
        {% endif %}

        {# Mobile menu button #}
        <button
          type="button"
          @click="mobileMenuOpen = !mobileMenuOpen"
          class="md:hidden p-2 text-zinc-100 hover:text-primary-300"
          :aria-expanded="mobileMenuOpen"
          aria-label="Toggle navigation menu"
        >
          <span x-show="!mobileMenuOpen">{% phosphor "list", "bold", { size: 24 } %}</span>
          <span x-show="mobileMenuOpen" x-cloak>{% phosphor "x", "bold", { size: 24 } %}</span>
        </button>
      </div>
    </nav>

    {# Mobile Navigation #}
    <div
      x-show="mobileMenuOpen"
      x-cloak
      x-collapse
      class="md:hidden border-t border-red-700/60"
    >
      <div class="py-4 space-y-2">
        {% for item in header.navigation %}
          <a
            href="{{ item.url }}"
            @click="mobileMenuOpen = false"
            class="block px-4 py-2 text-base font-semibold text-zinc-100 hover:text-primary-300 hover:bg-zinc-900 rounded-lg no-underline{% if page.url == item.url %} text-primary-300 bg-zinc-900{% endif %}"
          >
            {{ item.label }}
          </a>
        {% endfor %}

        {# Mobile CTA #}
        {% if header.cta %}
          <div class="px-4 pt-4">
            {{ button({
              text: header.cta.label,
              url: header.cta.url,
              variant: "primary",
              full: true
            }) }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</header>
