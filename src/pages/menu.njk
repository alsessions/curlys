{% set coldCuts = [
  { name: "Pastrami", price: "$14.29" },
  { name: "Turkey Ham", price: "$11.99" },
  { name: "Roast Beef", price: "$13.99" },
  { name: "Turkey", price: "$11.99" },
  { name: "Honey Turkey", price: "$11.99" },
  { name: "Buffalo Chicken", price: "$11.99" }
] %}

{% set cheeses = ["Provolone", "Swiss", "White American", "Yellow American Cheese", "Pepper Jack", "Mozzarella"] %}

<article class="bg-zinc-950">
  <header class="relative overflow-hidden border-b border-red-800/50">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(242,27,18,0.22),_transparent_34%),linear-gradient(135deg,_rgba(251,122,11,0.18),_transparent_40%)]"></div>
    <div class="container relative max-w-7xl py-16 md:py-20">
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-primary-300">Curly's Cheesesteaks and Grill</p>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
        <div>
          <h1 class="max-w-4xl text-balance text-zinc-50">Menu</h1>
          <p class="mt-5 max-w-2xl text-lg font-medium text-zinc-100 md:text-xl">
            Fresh, homemade, and stacked for a real grill appetite.
          </p>
        </div>
        <div class="border border-red-700/70 bg-zinc-900/80 p-5 shadow-lg shadow-red-950/30">
          <p class="text-sm font-bold uppercase tracking-wide text-pink-300">Delivery Available</p>
          <p class="mt-2 text-3xl font-extrabold text-red-400">8:00AM - 12:00AM</p>
          <p class="mt-4 text-zinc-100">400 N James St, Rome NY 13440</p>
          <p class="mt-3 text-2xl font-extrabold text-primary-300">315-617-8375</p>
        </div>
      </div>
    </div>
  </header>

  <div class="container max-w-7xl py-12 md:py-16">
    <div class="grid gap-6 lg:grid-cols-3">
      {% for section in menuSections %}
        <section class="border border-red-800/70 bg-zinc-900/80 p-5 shadow-lg shadow-zinc-950/40 {% if section.title == 'Hot Sandwiches' or section.title == 'Cold Cut Subs' %}lg:col-span-1{% endif %}">
          <div class="mb-5">
            <div class="inline-flex min-w-56 items-center justify-center bg-pink-700 px-5 py-2 text-center shadow-md shadow-pink-950/50">
              <h2 class="text-xl font-extrabold uppercase tracking-wide text-zinc-50 md:text-2xl">{{ section.title }}</h2>
            </div>
            {% if section.note %}
              <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-red-300">{{ section.note }}</p>
            {% endif %}
          </div>

          {% if section.columns %}
            <div class="mb-2 grid grid-cols-[minmax(0,1fr)_4rem_4rem] gap-3 text-right text-xs font-bold uppercase tracking-wide text-primary-300">
              <span></span>
              <span>{{ section.columns[0] }}</span>
              <span>{{ section.columns[1] }}</span>
            </div>
          {% endif %}

          <ul class="space-y-3">
            {% for item in section.items %}
              <li class="grid gap-x-3 {% if section.columns %}grid-cols-[minmax(0,1fr)_4rem_4rem]{% else %}grid-cols-[minmax(0,1fr)_auto]{% endif %}">
                <div class="min-w-0">
                  <div class="flex items-baseline gap-2">
                    <span class="h-2 w-2 shrink-0 rounded-full bg-red-500"></span>
                    <span class="min-w-0 text-base font-extrabold uppercase tracking-wide text-zinc-50 break-words leading-snug">{{ item.name }}</span>
                    <span class="min-w-8 flex-1 border-b border-dotted border-zinc-500"></span>
                  </div>
                  {% if item.meta %}
                    <p class="mt-1 pl-4 text-sm leading-snug text-zinc-300">{{ item.meta }}</p>
                  {% endif %}
                </div>
                <span class="text-right text-base font-extrabold text-zinc-50">{{ item.price }}</span>
                {% if section.columns %}
                  <span class="text-right text-base font-extrabold text-zinc-50">{{ item.price2 }}</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endfor %}

      <section class="border border-red-800/70 bg-zinc-900/80 p-5 shadow-lg shadow-zinc-950/40 lg:col-span-2">
        <div class="mb-5 grid gap-4 md:grid-cols-[minmax(0,1fr)_18rem] md:items-start">
          <div>
            <div class="inline-flex min-w-56 items-center justify-center bg-pink-700 px-5 py-2 text-center shadow-md shadow-pink-950/50">
              <h2 class="text-xl font-extrabold uppercase tracking-wide text-zinc-50 md:text-2xl">Cold Cuts</h2>
            </div>
            <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-red-300">Priced per lb</p>
          </div>
          <div class="md:text-right">
            <h3 class="text-2xl font-extrabold text-red-400">Cheese Selection</h3>
            <p class="mt-1 text-sm font-bold uppercase tracking-wide text-red-300">Priced per lb</p>
            <p class="mt-1 text-3xl font-extrabold leading-none text-primary-300">$11.99</p>
          </div>
        </div>

        <div class="grid gap-8 md:grid-cols-2">
          <ul class="space-y-3">
            {% for item in coldCuts %}
              <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-3">
                <div class="flex items-baseline gap-2">
                  <span class="h-2 w-2 shrink-0 rounded-full bg-red-500"></span>
                  <span class="min-w-0 text-base font-extrabold uppercase tracking-wide text-zinc-50 break-words leading-snug">{{ item.name }}</span>
                  <span class="min-w-8 flex-1 border-b border-dotted border-zinc-500"></span>
                </div>
                <span class="text-right text-base font-extrabold text-zinc-50">{{ item.price }}</span>
              </li>
            {% endfor %}
          </ul>
          <ul class="grid content-start gap-x-8 gap-y-3 sm:grid-cols-2 md:pt-1">
            {% for cheese in cheeses %}
              <li class="flex items-center gap-2 text-base font-semibold text-zinc-100">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-500"></span>
                {{ cheese }}
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>
    </div>
  </div>
</article>
