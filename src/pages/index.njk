---
layout: layouts/base.njk
title: Home
description: A vibrant 11ty starter with Tailwind CSS and Alpine.js. Fast, accessible, and beautifully designed.
permalink: /index.html
---
{% from "_components/index.njk" import button, card, badge, accordion %}

{# Hero Section #}
<section class="relative min-h-[calc(100vh-5rem)] overflow-hidden bg-zinc-950">
  <img
    src="/assets/images/3F10ED09-7E3F-45E5-9933-32AC2473A656.png"
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-center opacity-55"
    loading="eager"
    eleventy:ignore
  >
  <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/65 via-zinc-950/45 to-zinc-950"></div>
  <div class="relative container flex min-h-[calc(100vh-5rem)] items-end pb-12 pt-24 md:pb-16">
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-primary-300">Rome, NY</p>
      <h1 class="text-balance text-zinc-50 drop-shadow-lg">
        Curly's Cheese Steaks and Grill
      </h1>
      <p class="mt-5 max-w-xl text-xl font-medium text-zinc-100 text-pretty drop-shadow">
        Philly cheesesteaks with a New York twist, stacked burgers, hot fries, and fresh smoothies.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        {{ button({
          text: "View Menu",
          url: "/menu/",
          variant: "primary",
          size: "lg"
        }) }}
      </div>
    </div>
  </div>
</section>

{# Specials Section #}
<section class="section bg-zinc-950">
  <div class="container">
    <div class="mx-auto mb-12 max-w-4xl text-center md:mb-16">
      <p class="mb-3 text-sm font-extrabold uppercase tracking-wider text-primary-300">Hot food, no fuss</p>
      <h2 class="text-5xl font-black uppercase leading-tight text-zinc-50 md:text-6xl lg:text-7xl">
        Get Fed Fast
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-semibold text-zinc-200 md:text-xl">
        Call ahead, grab delivery, or roll through for cheesesteaks, fries, smoothies, and grill favorites.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="card p-6">
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-300">Call Ahead</p>
        <h3 class="text-xl font-bold mb-2 text-zinc-50">Pickup Orders</h3>
        <p class="text-zinc-200">
          Give us a call and we will get your cheesesteaks, burgers, fries, and sides started.
        </p>
        <a href="tel:+13156178375" class="mt-5 inline-block text-2xl font-extrabold text-primary-300 no-underline hover:text-primary-200">315-617-8375</a>
      </div>

      <div class="card p-6">
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-300">Delivery</p>
        <h3 class="text-xl font-bold mb-2 text-zinc-50">Delivery Available</h3>
        <p class="text-zinc-200">
          Order through local delivery partners when you want Curly's brought straight to you.
        </p>
        <p class="mt-5 text-lg font-extrabold uppercase tracking-wide text-red-300">8:00AM - 12:00AM</p>
      </div>

      <div class="card p-6">
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-300">Rome, NY</p>
        <h3 class="text-xl font-bold mb-2 text-zinc-50">Find Us</h3>
        <p class="text-zinc-200">
          Stop in for cheesesteaks, breakfast platters, smoothies, desserts, and hot grill favorites.
        </p>
        <p class="mt-5 text-lg font-extrabold text-zinc-50">400 N James St<br>Rome, NY 13440</p>
      </div>
    </div>
  </div>
</section>





{# Map Section #}
<section class="bg-zinc-950 my-32">

  <div class="h-[26rem] w-full border-y border-red-800/70 md:h-[34rem]">
    <iframe
      src="https://www.google.com/maps?q=400%20N%20James%20St%2C%20Rome%2C%20NY%2013440&output=embed"
      title="Google map showing Curly's Cheesesteaks and Grill at 400 N James St, Rome, NY 13440"
      class="h-full w-full"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</section>
