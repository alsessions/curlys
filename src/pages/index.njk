---
layout: layouts/base.njk
title: Home
description: A vibrant 11ty starter with Tailwind CSS and Alpine.js. Fast, accessible, and beautifully designed.
permalink: /index.html
---
{% from "_components/index.njk" import button, card, badge, accordion %}

{# Hero Section #}
<section class="section bg-gradient-to-b from-primary-50 to-white">
  <div class="container text-center">
    <div class="max-w-3xl mx-auto">


      <h1 class="text-balance">
        Curly's <span class="text-gradient">Cheese Steaks and Grill</span> 
      </h1>

      <p class="mt-6 text-xl text-zinc-600 text-pretty hc:text-zinc-700">
        Philly Cheesesteaks with a New York twist.
      </p>

      <div class="flex flex-wrap justify-center gap-4 mt-8">
        {{ button({
          text: "View Menu",
          url: "/menu/",
          variant: "primary",
          size: "lg"
        }) }}


      </div>
    </div>
  </div>
</section>

{# Specials Section #}
<section class="section">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2>Specials</h2>
      <p class="mt-4 text-lg text-zinc-600 hc:text-zinc-700">
        Daily and weekly specials.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {# Special 1 #}
      <div class="card">
  
        <h3 class="text-xl font-bold mb-2">Something</h3>
        <p class="text-zinc-600 hc:text-zinc-700">
          A descrption of something.
        </p>
      </div>

      {# Feature 2 #}
      <div class="card">

        <h3 class="text-xl font-bold mb-2">Something Else</h3>
        <p class="text-zinc-600 hc:text-zinc-700">
          A description of something else.
        </p>
      </div>

      {# Feature 3 #}
      <div class="card">
       
        <h3 class="text-xl font-bold mb-2">One More</h3>
        <p class="text-zinc-600 hc:text-zinc-700">
       Yep, you guessed it, a third description.
        </p>
      </div>





    </div>
  </div>
</section>





{# CTA Section #}
<section class="section bg-primary-700 text-white">
  <div class="container text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-white">Order Now</h2>

      <div class="flex flex-wrap justify-center gap-4 mt-8">
        {{ button({
          text: "View Menu",
          url: "/menu/",
          variant: "white",
          size: "lg"
        }) }}
      </div>
    </div>
  </div>
</section>
